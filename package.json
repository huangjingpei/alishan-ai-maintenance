{
  "name": "huoke-radar-app",
  "version": "2.9.89",
  "private": true,
  "description": "抖多客(DDK)",
  "productName": "抖多客",
  "author": "Internal Maintenance Team",
  "main": "dist-protected/main.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "validate": "node --experimental-vm-modules scripts/validate.mjs",
    "integrity:report": "node scripts/integrity-report.mjs",
    "dev": "npm run validate && electron .",
    "dev:local": "npm run validate && node scripts/dev-local.mjs",
    "local:server": "node scripts/local-backend.mjs",
    "test": "node --test tests/*.test.mjs",
    "pack:dir": "npm run validate && electron-builder --dir",
    "dist:win": "npm run validate && electron-builder --win nsis --x64",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "axios": "^1.4.0",
    "better-sqlite3": "9.6.0",
    "bytenode": "1.5.7",
    "electron-store": "^8.1.0",
    "node-machine-id": "^1.1.12",
    "proxy-chain": "^2.7.1",
    "socks-proxy-agent": "^8.0.5",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.8",
    "@babel/traverse": "^7.29.8",
    "@electron/asar": "4.3.0",
    "electron": "24.8.8",
    "electron-builder": "26.15.3"
  }
}
